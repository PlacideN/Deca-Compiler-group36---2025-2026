// Description:
//    Test d'accès protected invalide (Restriction de visibilité).
//    Une sous-classe ne peut pas accéder au champ protected d'une instance de sa super-classe
//    si cette instance n'est pas (statiquement) du type de la sous-classe.
//
// Resultats:
//    Erreur contextuelle
//    Ligne 21 : Access to protected field 'x' is not allowed here. The object type (Mere) must be a subtype of the current class (Fille)
//
// Historique:
//    cree le 18/01/2026

class Mere {
    protected int x;
}

class Fille extends Mere {
    void test(Mere m) {
        // Erreur : m n'est pas forcément un 'Fille'.
        // m pourrait être une instance de 'Mere' ou 'AutreFille'.
        println(m.x); 
    }
}

{
}