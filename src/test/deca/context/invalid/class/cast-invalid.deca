// Description:
//    Test de cast invalide entre deux classes disjointes.
//    Impossible de caster 'A' en 'B' (types disjoints).
//
// Resultats:
//    Erreur contextuelle
//    Ligne 18 : Cannot cast from A to B
//
// Historique:
//    cree le 18/01/2026

class A {}
class B {}

{
    A a = new A();
    // Erreur : A n'est pas sous-type de B, et B n'est pas sous-type de A
    B b = (B) (a);
}