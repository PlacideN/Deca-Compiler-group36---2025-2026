// Description:
//    Test de conflit de nom de méthode (Surcharge interdite en Deca).
//    A a m(), B essaie de définir m(int) -> Interdit car même nom mais signature différente.
//
// Resultats:
//    Erreur contextuelle
//    Ligne 19 : Method 'm' signature does not match inherited method.
//
// Historique:
//    cree le 18/01/2026

class A {
    void m() {}
}

class B extends A {
    // Erreur : En Deca, on ne peut pas surcharger (overload) une méthode héritée.
    // Il faut soit Override (exactement pareil), soit un autre nom.
    void m(int i) {}
}

{
}