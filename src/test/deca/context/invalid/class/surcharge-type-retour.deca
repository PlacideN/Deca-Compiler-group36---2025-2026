// Description:
//    Test d'une surcharge invalide : type de retour incompatible.
//    A.m retourne int, B.m retourne float. Le type de retour 'float' 
//    n'est pas un sous-type du type de retour hérité 'int'.
//
// Resultats:
//    Erreur contextuelle
//    Ligne 21 : Method 'm' return type is not a valid subtype of inherited method.
//
// Historique:
//    cree le 17/01/2026

class A {
    int m() {
        return 0;
    }
}

class B extends A {
    // Erreur : float n'est pas un sous-type de int
    float m() {
        return 0.0;
    }
}

{
}