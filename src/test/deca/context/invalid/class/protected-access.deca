// Description:
//    Test d'accès illégal à un champ protégé depuis le programme principal (Main).
//
// Resultats:
//    Erreur contextuelle
//    Ligne 18 : Protected field 'x' cannot be accessed in main
//
// Historique:
//    cree le 17/01/2026

class A {
    protected int x;
}

{
    A a = new A();
    // Erreur : x est protected, accès interdit hors de la classe ou sous-classe
    println(a.x);
}