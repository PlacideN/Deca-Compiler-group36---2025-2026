// Description:
//    Test de l'opérateur de séléction (.).
//    Vérifie que l'arbre est correctement créé sans conflits d'identificateurs.
//
// Resultats:
//    Syntaxiquement correct
//
// Historique:
//    cree le 12/01/2026

class A {
    int field;
    void setField(int field) {
        this.field = field;
    }
}

{
    A.field = 5;
    (new A()).field = 10;
}