// Description:
//    Test d'une méthode avec des instructions en assembleur directement.
//    Vérifie que les instructions sont correctement ajoutées au fichier .ass.
//
// Resultats:
//    success
//
// Historique:
//    cree le 19/01/2026

class A {
    int loadConstant() asm ("
        LOAD #1, R0
        RTS
    ");
}

{
    A a = new A();
    if (a.loadConstant() == 1) {
        println("success");
    } else {
        println("fail");
    }
}