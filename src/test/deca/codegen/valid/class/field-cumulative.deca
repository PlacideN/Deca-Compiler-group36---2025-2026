// Description:
//    Test de sélection d'attributs publics de classes héritées.
//    Vérifie que les offsets des champs sont cumulatifs à travers 3 niveaux d'héritage.
// Resultats: 
//    101
//
// Historique:
//    19/01/2026

class A { int a = 1; }
class B extends A { int b = 0; }
class C extends B { int c = 1; }

{
    C c = new C();
    println(c.a, c.b, c.c);
}