// Description:
//      Test de print avec plusieurs arguments de types differents.
//      Vérifie que println("x peut s'ecrire: ", x, " ou ", f); 
//      est équivalent à print("x peut s'ecrire: ", x, " ou ", f); println();.
//
// Resultats:
//      x peut s'ecrire: 10 ou 1.00000e+01
//
// Historique:
//      cree le 09/01/2026

{
    int x = 10;
    float f = 10.0;
    println("x peut s'ecrire: ", x, " ou ", f);
}