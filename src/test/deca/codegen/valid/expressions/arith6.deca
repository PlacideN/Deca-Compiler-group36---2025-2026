// Description:
//      Test des opérations élémentaires avec des flottants.
//
// Resultats:
//      4.00000e+00
//      1.20000e+01
//      1.00000e+01
//      1.00000e-01
//
// Historique:
//      cree le 09/01/2026

{
    float f = 0;
    f = f + 4.0;
    println(f);
    f = f * 3.0;
    println(f);
    f = f - 2.0;
    println(f);
    f = 1.0 / f;
    println(f);
}