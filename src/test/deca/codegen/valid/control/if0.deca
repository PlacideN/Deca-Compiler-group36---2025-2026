// Description:
//    Test d'un if simple.
//    Vérifie l'évaluation d'une condition booléenne vraie et le saut
//    conditionnel vers le bloc 'then'.
//
// Resultats:
//      then
//      end
//
// Historique:
//      cree le 08/01/2026

{
    if (true) {
        println("then");
    } else {
        println("else");
    }
    println("end");
}