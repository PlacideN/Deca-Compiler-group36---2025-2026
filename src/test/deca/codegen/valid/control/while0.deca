// Description:
//      Test d'une boucle while simple avec décrémentation.
//      Vérfie l'ajout des labels et le saut tant que la condition booléenne est fausse.
//
// Resultats:
//      3
//      2
//      1
//
// Historique:
//      cree le 09/01/2026

{
    int i = 3;
    while (i > 0) {
        println(i);
        i = i - 1;
    }
}
