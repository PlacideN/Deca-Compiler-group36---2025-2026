// Description:
//    Test d'une boucle while simple avec décrémentation.
//    Vérifie la génération des labels de boucle et le saut arrière.
//
// Resultats:
//    3
//    2
//    1
//
// Historique:
//    cree le 09/01/2026

{
    int i = 3;
    while (i > 0) {
        println(i);
        i = i - 1;
    }
}
