// Grenoble INP - Ensimag projet GL -*- mode: java -*-
// Library for class Math of Deca, coded in Deca
// Author : gl36

class Math {

    // Calcule cos(f) pour f dans [-π/4, π/4]
    float _cos_horner(float f) {
        float f_2 = f * f;
        float a = -0.5;
        float b = 0.04166666;
        float c = -0.001388889;
        float d = 0.000024801;
        
        return 1.0 + f_2 * (a + f_2 * (b + f_2 * (c + f_2 * d)));
    }

    // Calcule sin(f) pour f dans [-π/4, π/4]
    float _sin_horner(float f) {
        float f_2 = f * f;
        float a = -0.1666667;
        float b = 0.008333333;
        float c = -0.000198413;
        float d = 0.000002756;

        return f * (1.0 + f_2 * (a + f_2 * (b + f_2 * (c + f_2 * d))));
    }
    
    // calcule atan(f) pour f dans [0, tan(pi/8)] au degré 15
    float _atan_horner(float f) {
        float f2 = f * f;
        float A1 = -0.3333333333; // -1/3
        float A2 =  0.2000000000; //  1/5
        float A3 = -0.1428571429; // -1/7
        float A4 =  0.1111111111; //  1/9
        float A5 = -0.0909090909; // -1/11
        float A6 =  0.0769230769; //  1/13
        float A7 = -0.0666666667; // -1/15

        return f * (1.0 + f2 * (A1 + f2 * (A2 + f2 * (A3 + f2 * (A4 + f2 * (A5 + f2 * (A6 + f2 * A7)))))));
    }

    float _reduced_angle(float f) {
        float PI_INV = 0.636619772; 
        float PI_HALF_1 = 1.5703125; 
        float PI_HALF_2 = 0.000480651855;
        float PI_HALF_3 = 3.17493994e-6; 
        float k_float;
        int k;
        float r;

        if (f < 0.0){
            k_float = (f * PI_INV) - 0.5; 
        }
        else {
            k_float = (f * PI_INV) + 0.5;
        }
        
        k = (int)(k_float); 
        k_float = (float)(k);

        // Reduction de Cody-Waite étendue
        r = f - (k_float * PI_HALF_1);
        r = r - (k_float * PI_HALF_2);
        r = r - (k_float * PI_HALF_3);
        return r;
    }

    int _get_k(float f) {
        float PI_INV = 0.63661977236;
        float k_float;
        
        if (f < 0.0) {
            k_float = (f * PI_INV) - 0.5; 
        }
        else {
            k_float = (f * PI_INV) + 0.5;
        }
        return (int)(k_float); 
    }

    float _sqrt(float f) {
        float y;
        int i;

        if (f < 0.0) {
            return 0.0 / (f - f); // NaN
        }

        if (f == 0.0) {
            return 0.0;
        }

        y = 1.0;

        i = 0;
        while (i < 15) {
            y = 0.5 * (y + f / y);
            i = i + 1;
        }

        return y;
    }

    float sin(float f) {
        float r;
        int k;
        int quadrant;

        if (f > -0.0007 && f < 0.0007){
            return f;
        }
        
        r = _reduced_angle(f);
        k = _get_k(f);
        
        quadrant = k % 4;
        if (quadrant < 0) {
            quadrant = quadrant + 4;
        }

        if (quadrant == 0) {
            return _sin_horner(r);
        } else if (quadrant == 1) {
            return _cos_horner(r);
        } else if (quadrant == 2) {
            return -_sin_horner(r);
        } else {
            return -_cos_horner(r);
        }
    }

    float cos(float f) {
        float r;
        int k;
        int quadrant;

        if (f > -0.00047 && f < 0.00047){
            return 1.0;
        }
        
        r = _reduced_angle(f);
        k = _get_k(f);
        quadrant = k % 4;
        if (quadrant < 0) {
            quadrant = quadrant + 4;
        }
        
        if (quadrant == 0) {
            return _cos_horner(r);
        } else if (quadrant == 1) {
            return -_sin_horner(r);
        } else if (quadrant == 2) {
            return -_cos_horner(r);
        } else {
            return _sin_horner(r);
        }
    }

    float asin(float f) {
        float x; 

        // return 0.0 / (f - f), cela permet de lever
        // une exception de division par 0 puisque ça renvoie un Nan
        // Si on avait mis 0.0/0.0 ça ne marcherait par
        // car ça ne serait jamais permis
        if (f > 1.0 || f < -1.0) {
            return 0.0 / (f - f);
        }

        if (f < 0.0) {
            return -asin(-f);
        }

        x = _sqrt(1.0 - f * f);
        return atan(f / x);
    }

    float atan(float f) {
        float PI_HALF = 1.5707963267;
        float PI_QUART = 0.7853981633;
        float x; 

        if (f < 0.0) {
            return -atan(-f);
        }

        if (f < 0.0007){
            return f;
        }

        if (f > 2.41421356) {
            return PI_HALF - _atan_horner(1.0 / f);
        }

        if (f > 0.41421) {
            x = (f - 1.0) / (f + 1.0);
            return PI_QUART + _atan_horner(x);
        }

        return _atan_horner(f);
    }

    // Fonction valeur absolue
    float _abs(float x){
        if (x < 0.0){
            return -x;
        }
        return x;
    }

    // Fonction ulp
    float ulp(float x) {
        float e = 1.1920929E-7; 
        
        float abs_x = _abs(x);

        if (abs_x < 1.17549435E-38) { 
             return 1.4E-45; 
        }

        while (abs_x >= 2.0) {
            abs_x = abs_x / 2.0;
            e = e * 2.0;
        }

        while (abs_x < 1.0) {
             abs_x = abs_x * 2.0;
             e = e / 2.0;
        }

        return e;
    }
}

// End of Deca Math library