// Library for class Math of Deca, coded in Deca

class Math {
    float _PI() {
        return 3.14159265358979323846f;
    }

        float _TWO_PI() {
        return 6.28318530717958647692f;
    }

    float _reduce_angle(float f) {
        float PI = _PI();
        float TWO_PI = _TWO_PI();
        float signe = 1.0f;

        if (f < 0.0) {
            f = -f;
            signe = -1.0f;
        }

        while (f > PI) {
            f = f - TWO_PI;
        }

        if (f > PI / 2.0f) {
            f = PI - f;
        }

        if (f > PI / 2.0f) {
            f = PI - f; 
        } else if (f < -PI / 2.0f) {
            f = -PI - f;    
        }

        return signe * f;
}

    float sin(float f) {
        f = _reduce_angle(f);
        float x2 = f * f;
        float r = -0.0000000250521084f;
        r =  0.00000275573192f + x2 * r;
        r = -0.0001984126984f + x2 * r;
        r =  0.00833333333f + x2 * r;
        r = -0.166666667f + x2 * r;
        r =  1.0f + x2 * r;

        return f * r;
        
    }

    float cos(float f) {
        println("cos(f) not yet implemented");
    }
    float asin(float f) {
        println("asin(f) not yet implemented");
    }
    float atan(float f) {
        println("atan(f) not yet implemented");
    }

    float ulp(float x) {

        float e = 1.1920929E-7f; 

        x = abs(x);

        if (x < 1.17549435E-38f) { 
             return 1.4E-45f; 
        }

        while (x >= 2.0f) {
            x = x / 2.0f;
            e = e * 2.0f;
        }

        while (x < 1.0f) {
             x = x * 2.0f;
             e = e / 2.0f;
        }

        return e;
    }
}


// End of Deca Math library
